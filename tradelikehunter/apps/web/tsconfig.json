{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@tlh/domain": ["../../packages/domain/src/index.ts"],
      "@tlh/ui": ["../../packages/ui/src/index.ts"],
      "@tlh/contracts": ["../../packages/contracts/src/index.ts"],
      "@/*": ["src/*"]
    }
  },
  "include": ["src", "test", "vite.config.ts"]
}
