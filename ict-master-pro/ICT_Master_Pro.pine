//@version=6
// ════════════════════════════════════════════════════════════════════════════════════
//   ICT MASTER PRO  —  All-in-One ICT / SMC Confluence Indicator (Pine v6)
//   ────────────────────────────────────────────────────────────────────────────────
//   Combines: Market Structure (BOS/CHoCH) · Liquidity Sweeps (BSL/SSL)
//             · Order Blocks (graded) · Fair Value Gaps · Premium/Discount
//             · OTE (0.62 / 0.705 / 0.79) · Weekly Profile bias
//             · ICT Macro Session Boxes · Volume confirmation · HTF bias filter
//             · Confluence-scored BUY / SELL signals with SL + TP1 / TP2 / TP3
//
//   Built for NSE (NIFTY / BANKNIFTY / FINNIFTY) intraday in IST, but works on any
//   symbol / timeframe. Defaults are tuned for 5m and 15m charts.
//
//   Philosophy: ONE clean signal only when multiple ICT confluences align.
//               No noise. Pure price + time + volume + structure.
// ════════════════════════════════════════════════════════════════════════════════════

indicator("ICT Master Pro", shorttitle = "ICT-MP", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_bars_back = 5000)

// ════════════════════════════════════════════════════════════════════════════════════
//   1. INPUTS
// ════════════════════════════════════════════════════════════════════════════════════
grpCore   = "═══ Core ═══"
grpStruct = "═══ Market Structure ═══"
grpOB     = "═══ Order Blocks ═══"
grpFVG    = "═══ Fair Value Gaps ═══"
grpLiq    = "═══ Liquidity & Sweeps ═══"
grpPD     = "═══ Premium / Discount ═══"
grpHTF    = "═══ HTF Bias ═══"
grpSess   = "═══ ICT Macro Sessions (IST) ═══"
grpSig    = "═══ Signal Engine ═══"
grpRisk   = "═══ Risk: SL / TP ═══"
grpDash   = "═══ Dashboard ═══"

// ── Core ────────────────────────────────────────────────────────────────────────────
i_cleanMode     = input.bool(true, "CLEAN MODE (only signals + dashboard on chart)", group = grpCore, tooltip = "ON = clean chart, only BUY/SELL signals with Entry/SL/TP visible. OFF = show all ICT internals (OB, FVG, liquidity lines, sessions, P/D zones).")
i_pivotLen      = input.int(5,    "Pivot Length", minval = 2, maxval = 30, group = grpCore, tooltip = "Bars on each side for swing detection. 5 = scalp, 10 = swing.")
i_useVolume     = input.bool(true, "Require Volume Confirmation", group = grpCore, tooltip = "Signals only fire when volume >= average. Crucial for high-probability setups.")
i_volLen        = input.int(20,   "Volume MA Length", minval = 5, maxval = 200, group = grpCore)

// ── Structure ───────────────────────────────────────────────────────────────────────
i_showBOS_raw    = input.bool(false, "Show BOS / CHoCH",              group = grpStruct)
i_showSwings_raw = input.bool(false, "Show Swing High / Low markers", group = grpStruct)

// ── Order Blocks ────────────────────────────────────────────────────────────────────
i_showOB_raw    = input.bool(false, "Show Order Blocks",             group = grpOB)
i_obMaxBoxes    = input.int(8,    "Max OB Boxes Kept", minval = 1, maxval = 20, group = grpOB)
i_obMitigate    = input.bool(true, "Remove OBs after Mitigation",   group = grpOB)
i_obGrade       = input.string("A+B", "Min Grade to Show", options = ["A only", "A+B", "A+B+C"], group = grpOB, tooltip = "A = swept liquidity + displacement, B = displacement only, C = simple.")

// ── FVG ─────────────────────────────────────────────────────────────────────────────
i_showFVG_raw   = input.bool(false, "Show Fair Value Gaps",          group = grpFVG)
i_fvgMaxBoxes   = input.int(6,    "Max FVG Boxes Kept", minval = 1, maxval = 20, group = grpFVG)
i_fvgMitigate   = input.bool(true, "Remove FVGs after Fill",        group = grpFVG)

// ── Liquidity ───────────────────────────────────────────────────────────────────────
i_showLiq_raw   = input.bool(false, "Show BSL / SSL Liquidity Lines", group = grpLiq)
i_showSweep_raw = input.bool(false, "Mark Liquidity Sweeps",          group = grpLiq)
i_liqMax        = input.int(6,    "Max Liquidity Lines per side", minval = 1, maxval = 15, group = grpLiq)

// ── Premium / Discount ──────────────────────────────────────────────────────────────
i_showPD_raw    = input.bool(false, "Show Premium / Discount Zones", group = grpPD)
i_pdSource      = input.string("Daily", "Range Source", options = ["Daily", "Weekly", "Session"], group = grpPD)
i_showWeeklyOHLC = input.bool(false, "Show Weekly OHLC Lines",       group = grpPD)

// ── HTF Bias ────────────────────────────────────────────────────────────────────────
i_useHTFBias    = input.bool(true, "Filter Signals by HTF Bias", group = grpHTF)
i_htfTF         = input.timeframe("60", "HTF Timeframe", group = grpHTF, tooltip = "60 = 1H, 240 = 4H, D = Daily, W = Weekly. 1H is good for 5m charts.")

// ── Sessions ────────────────────────────────────────────────────────────────────────
i_useSessions_raw = input.bool(false, "Show NSE ICT Macro Boxes",        group = grpSess)
i_sessAM        = input.session("0915-1045", "AM Macro (Open Drive)", group = grpSess)
i_sessMid       = input.session("1045-1200", "Mid Morning",           group = grpSess)
i_sessLunch     = input.session("1200-1330", "Lunch (Avoid)",         group = grpSess)
i_sessPM        = input.session("1330-1500", "PM Macro",              group = grpSess)
i_sessExpiry    = input.session("1430-1530", "Expiry / Close Window", group = grpSess)
i_avoidLunch    = input.bool(true, "Block Signals during Lunch",      group = grpSess)
i_tz            = input.string("Asia/Kolkata", "Timezone", options = ["Asia/Kolkata", "America/New_York", "Europe/London", "UTC"], group = grpSess)

// ── Signal Engine ───────────────────────────────────────────────────────────────────
i_minScore      = input.int(5, "Min Confluence Score (0-7)", minval = 1, maxval = 7, group = grpSig, tooltip = "Higher = fewer but stronger signals. 5 = balanced quality, 6+ = sniper.")
i_useOTE        = input.bool(true, "Require OTE Zone (0.62-0.79)",      group = grpSig)
i_requireBarConf= input.bool(true, "Require Reversal Bar Confirmation", group = grpSig, tooltip = "Buys need close > open on signal bar; sells need close < open. Filters fakeouts.")
i_structMemBars = input.int(10, "Structure Memory (bars)", minval = 3, maxval = 30, group = grpSig, tooltip = "How many bars after BOS/CHoCH the setup stays valid. Lets the signal fire on the RETRACE bar (before the move) instead of the breakout bar.")
i_sweepMemBars  = input.int(8,  "Sweep Memory (bars)",     minval = 3, maxval = 30, group = grpSig)
i_useInducement = input.bool(true, "Require Major Liquidity Sweep (filter inducement)", group = grpSig, tooltip = "Only fire signals when the recent sweep was on MAJOR liquidity (equal highs/lows, PDH/PDL, PWH/PWL). Filters fake sweeps that trap retail.")
i_useRegime     = input.bool(false, "Filter by Market Regime", group = grpSig, tooltip = "When ON, blocks BUY in strong downtrends and SELL in strong uptrends. Regime is always shown on the dashboard regardless.")

// ── Risk ────────────────────────────────────────────────────────────────────────────
i_slMode        = input.string("Structure", "SL Mode", options = ["Structure", "ATR", "Fixed%"], group = grpRisk, tooltip = "Structure = beyond swept liquidity / OB. ATR = ATR multiple. Fixed% = % of price.")
i_slATR         = input.float(1.5,  "SL ATR Multiple", minval = 0.5,  maxval = 5.0,  step = 0.1,  group = grpRisk)
i_slFixedPct    = input.float(0.3,  "SL Fixed %",      minval = 0.05, maxval = 5.0,  step = 0.05, group = grpRisk)
i_slBuffer      = input.float(0.05, "SL Buffer %",     minval = 0.0,  maxval = 1.0,  step = 0.01, group = grpRisk)
i_useAdaptiveTP = input.bool(true, "Adaptive Targets (price-action levels)", group = grpRisk, tooltip = "TP1/TP2/TP3 are projected to the next liquidity pool / opposing OB / HTF level above (or below) entry, instead of fixed R multiples. Falls back to R multiples when not enough structure exists.")
i_tp1R          = input.float(1.0, "TP1 (R multiple, fallback)", minval = 0.5, maxval = 10, step = 0.1, group = grpRisk)
i_tp2R          = input.float(2.0, "TP2 (R multiple, fallback)", minval = 0.5, maxval = 10, step = 0.1, group = grpRisk)
i_tp3R          = input.float(3.0, "TP3 (R multiple, fallback)", minval = 0.5, maxval = 10, step = 0.1, group = grpRisk)
i_useRiskCalc   = input.bool(false, "Position-size in Alerts", group = grpRisk, tooltip = "Add suggested position size to alert messages, computed from account size and risk per trade.")
i_account       = input.float(100000, "Account Size", minval = 1000, group = grpRisk)
i_riskPct       = input.float(1.0, "Risk per Trade (%)", minval = 0.1, maxval = 5.0, step = 0.1, group = grpRisk)

// ── Key Levels (PDH/PDL/PWH/PWL/PMH/PML) ────────────────────────────────────────────
grpKey          = "═══ Key Levels ═══"
i_showKeyLevels = input.bool(false, "Show Key Levels (PDH/PDL/PWH/PWL)", group = grpKey, tooltip = "Plot previous-day and previous-week high/low. These act as major liquidity targets.")
i_useKeyAsTP    = input.bool(true,  "Use Key Levels as TP destinations", group = grpKey, tooltip = "When Adaptive Targets is ON, also project to PDH/PDL/PWH/PWL.")

// ── Performance Tracker ─────────────────────────────────────────────────────────────
grpPerf         = "═══ Performance ═══"
i_trackPerf     = input.bool(true, "Track Signal Performance", group = grpPerf, tooltip = "Tracks each fired signal until SL/TP3 hits, then computes win rate, average R, max drawdown over the rolling window.")
i_perfWindow    = input.int(30, "Performance Window (signals)", minval = 5, maxval = 200, group = grpPerf)
i_showPerfLines = input.bool(false, "Mark Closed Trades on Chart", group = grpPerf, tooltip = "Drop a tiny WIN/LOSS marker on past signals once they resolve. Off by default to keep the chart clean.")

// ── Dashboard ───────────────────────────────────────────────────────────────────────
i_showDash      = input.bool(true, "Show Dashboard", group = grpDash)
i_dashPos       = input.string("Top Right", "Dashboard Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group = grpDash)
i_dashSize      = input.string("Small", "Dashboard Size", options = ["Tiny", "Small", "Normal", "Large"], group = grpDash)

// ── Effective show flags (Clean Mode forces everything off) ─────────────────────────
i_showBOS     = i_cleanMode ? false : i_showBOS_raw
i_showSwings  = i_cleanMode ? false : i_showSwings_raw
i_showOB      = i_cleanMode ? false : i_showOB_raw
i_showFVG     = i_cleanMode ? false : i_showFVG_raw
i_showLiq     = i_cleanMode ? false : i_showLiq_raw
i_showSweep   = i_cleanMode ? false : i_showSweep_raw
i_showPD      = i_cleanMode ? false : i_showPD_raw
i_useSessions = i_cleanMode ? false : i_useSessions_raw
i_showWeekly  = i_cleanMode ? false : i_showWeeklyOHLC
i_showKey     = i_cleanMode ? false : i_showKeyLevels

// ── Colors ──────────────────────────────────────────────────────────────────────────
c_bull       = color.new(#26a69a, 0)
c_bear       = color.new(#ef5350, 0)
c_obBull     = color.new(#1976d2, 80)
c_obBear     = color.new(#f57c00, 80)
c_fvgBull    = color.new(#00bcd4, 85)
c_fvgBear    = color.new(#ff9800, 85)
c_liqBuy     = color.new(#ff5252, 0)
c_liqSell    = color.new(#69f0ae, 0)
c_premium    = color.new(#ef5350, 92)
c_discount   = color.new(#26a69a, 92)
c_sessAM     = color.new(#2962ff, 88)
c_sessMid    = color.new(#43a047, 90)
c_sessLunch  = color.new(#9e9e9e, 92)
c_sessPM     = color.new(#8e24aa, 88)
c_sessExpiry = color.new(#d50000, 88)
c_slLine     = color.new(#b00020, 0)
c_tpBuy      = color.new(#00c853, 0)
c_tpSell     = color.new(#ff6f00, 0)

// ════════════════════════════════════════════════════════════════════════════════════
//   2. UTILITY HELPERS
// ════════════════════════════════════════════════════════════════════════════════════
f_inSession(_sess) =>
    not na(time(timeframe.period, _sess, i_tz))

f_dashPos() =>
    i_dashPos == "Top Right" ? position.top_right : i_dashPos == "Top Left" ? position.top_left : i_dashPos == "Bottom Right" ? position.bottom_right : i_dashPos == "Bottom Left" ? position.bottom_left : position.middle_right

f_dashSize() =>
    i_dashSize == "Tiny" ? size.tiny : i_dashSize == "Small" ? size.small : i_dashSize == "Normal" ? size.normal : size.large

atr14 = ta.atr(14)
volMA = ta.sma(volume, i_volLen)
volOK = i_useVolume ? (volume >= volMA) : true

// ════════════════════════════════════════════════════════════════════════════════════
//   3. HIGHER TIMEFRAME BIAS
// ════════════════════════════════════════════════════════════════════════════════════
htfClose = request.security(syminfo.tickerid, i_htfTF, close, lookahead = barmerge.lookahead_off)
htfEma50 = request.security(syminfo.tickerid, i_htfTF, ta.ema(close, 50), lookahead = barmerge.lookahead_off)
htfEma20 = request.security(syminfo.tickerid, i_htfTF, ta.ema(close, 20), lookahead = barmerge.lookahead_off)

htfBull = not na(htfEma50) and htfClose > htfEma50 and htfEma20 > htfEma50
htfBear = not na(htfEma50) and htfClose < htfEma50 and htfEma20 < htfEma50
htfBiasStr = htfBull ? "BULLISH UP" : htfBear ? "BEARISH DN" : "NEUTRAL"
htfBiasCol = htfBull ? c_bull : htfBear ? c_bear : color.gray

// ── Regime detection (Trending / Ranging / Transition) ──────────────────────────────
// ADX-style strength of directional movement. Avoids reversal signals in strong
// trends and continuation signals in tight ranges.
_dmPlus  = high  - high[1]
_dmMinus = low[1] - low
plusDM   = (_dmPlus  > _dmMinus and _dmPlus  > 0) ? _dmPlus  : 0.0
minusDM  = (_dmMinus > _dmPlus  and _dmMinus > 0) ? _dmMinus : 0.0
trAvg    = ta.rma(ta.tr, 14)
plusDI   = trAvg == 0 ? 0.0 : 100 * ta.rma(plusDM, 14)  / trAvg
minusDI  = trAvg == 0 ? 0.0 : 100 * ta.rma(minusDM, 14) / trAvg
diSum    = plusDI + minusDI
dx       = diSum == 0 ? 0.0 : 100 * math.abs(plusDI - minusDI) / diSum
adx      = ta.rma(dx, 14)

regimeTrending = adx >= 25
regimeRanging  = adx <  18
regimeStr      = regimeTrending ? "TRENDING" : regimeRanging ? "RANGING" : "TRANSITION"
regimeCol      = regimeTrending ? color.new(#1565c0, 0) : regimeRanging ? color.new(#ef6c00, 0) : color.new(color.gray, 0)

// Soft regime filter: when enabled, block buy in strong downtrends and sell in
// strong uptrends. Range-bound regimes still allow both sides (mean reversion).
regimeAllowsBuy  = i_useRegime ? not (regimeTrending and htfBear) : true
regimeAllowsSell = i_useRegime ? not (regimeTrending and htfBull) : true

// Daily / Weekly OHLC for premium-discount and weekly profile
dHigh = request.security(syminfo.tickerid, "D", high, lookahead = barmerge.lookahead_on)
dLow  = request.security(syminfo.tickerid, "D", low,  lookahead = barmerge.lookahead_on)
wHigh = request.security(syminfo.tickerid, "W", high, lookahead = barmerge.lookahead_on)
wLow  = request.security(syminfo.tickerid, "W", low,  lookahead = barmerge.lookahead_on)
wOpen = request.security(syminfo.tickerid, "W", open, lookahead = barmerge.lookahead_on)

// Previous-day / previous-week / previous-month highs and lows — major liquidity
pdHigh = request.security(syminfo.tickerid, "D", high[1], lookahead = barmerge.lookahead_on)
pdLow  = request.security(syminfo.tickerid, "D", low[1],  lookahead = barmerge.lookahead_on)
pwHigh = request.security(syminfo.tickerid, "W", high[1], lookahead = barmerge.lookahead_on)
pwLow  = request.security(syminfo.tickerid, "W", low[1],  lookahead = barmerge.lookahead_on)
pmHigh = request.security(syminfo.tickerid, "M", high[1], lookahead = barmerge.lookahead_on)
pmLow  = request.security(syminfo.tickerid, "M", low[1],  lookahead = barmerge.lookahead_on)

// Plot key levels (when not in clean mode)
plot(i_showKey ? pdHigh : na, "PDH", color = color.new(#ff5252, 30), style = plot.style_linebr, linewidth = 1)
plot(i_showKey ? pdLow  : na, "PDL", color = color.new(#69f0ae, 30), style = plot.style_linebr, linewidth = 1)
plot(i_showKey ? pwHigh : na, "PWH", color = color.new(#ff5252, 0),  style = plot.style_linebr, linewidth = 2)
plot(i_showKey ? pwLow  : na, "PWL", color = color.new(#69f0ae, 0),  style = plot.style_linebr, linewidth = 2)
plot(i_showKey ? pmHigh : na, "PMH", color = color.new(#d50000, 0),  style = plot.style_linebr, linewidth = 2)
plot(i_showKey ? pmLow  : na, "PML", color = color.new(#00c853, 0),  style = plot.style_linebr, linewidth = 2)

// ════════════════════════════════════════════════════════════════════════════════════
//   4. MARKET STRUCTURE — Swings, BOS, CHoCH
// ════════════════════════════════════════════════════════════════════════════════════
phRaw = ta.pivothigh(high, i_pivotLen, i_pivotLen)
plRaw = ta.pivotlow(low,   i_pivotLen, i_pivotLen)

var float lastSH    = na
var float lastSL    = na
var int   lastSHBar = na
var int   lastSLBar = na

if not na(phRaw)
    lastSH    := phRaw
    lastSHBar := bar_index - i_pivotLen

if not na(plRaw)
    lastSL    := plRaw
    lastSLBar := bar_index - i_pivotLen

// Track current structural state (1 = bullish, -1 = bearish, 0 = neutral)
var int trend = 0

bullBOS = not na(lastSH) and close > lastSH and close[1] <= lastSH
bearBOS = not na(lastSL) and close < lastSL and close[1] >= lastSL

// CHoCH = first opposing BOS after a trend change
bullCHoCH = bullBOS and trend == -1
bearCHoCH = bearBOS and trend ==  1

if bullBOS
    trend := 1
if bearBOS
    trend := -1

// Memory of recent structural shifts so the signal can fire on the RETRACE bar
// (i.e. AFTER the BOS/CHoCH, when price returns to the OB/FVG) — that's the
// pre-move entry, not the breakout chase.
var int lastBullStructBar = na
var int lastBearStructBar = na
if bullBOS or bullCHoCH
    lastBullStructBar := bar_index
if bearBOS or bearCHoCH
    lastBearStructBar := bar_index
recentBullStruct = not na(lastBullStructBar) and (bar_index - lastBullStructBar) <= i_structMemBars
recentBearStruct = not na(lastBearStructBar) and (bar_index - lastBearStructBar) <= i_structMemBars

if i_showBOS and bullBOS and not na(lastSHBar)
    line.new(lastSHBar, lastSH, bar_index, lastSH, color = c_bull, width = 1, style = line.style_dashed)
    label.new(bar_index, lastSH, bullCHoCH ? "CHoCH UP" : "BOS UP", color = c_bull, textcolor = color.white, style = label.style_label_down, size = size.tiny)

if i_showBOS and bearBOS and not na(lastSLBar)
    line.new(lastSLBar, lastSL, bar_index, lastSL, color = c_bear, width = 1, style = line.style_dashed)
    label.new(bar_index, lastSL, bearCHoCH ? "CHoCH DN" : "BOS DN", color = c_bear, textcolor = color.white, style = label.style_label_up, size = size.tiny)

// Swing markers
if i_showSwings and not na(phRaw)
    label.new(bar_index - i_pivotLen, phRaw, "H", color = color.new(c_bear, 70), textcolor = color.white, style = label.style_label_down, size = size.tiny)
if i_showSwings and not na(plRaw)
    label.new(bar_index - i_pivotLen, plRaw, "L", color = color.new(c_bull, 70), textcolor = color.white, style = label.style_label_up, size = size.tiny)

// ════════════════════════════════════════════════════════════════════════════════════
//   5. ORDER BLOCKS — graded A / B / C
// ════════════════════════════════════════════════════════════════════════════════════
type OB
    box    bx
    float  top
    float  bot
    bool   bull
    string grade
    bool   mitigated

var array<OB> obs = array.new<OB>()

displacement = (high - low) > 1.5 * atr14
swept_low_recently  = ta.lowest(low,  3) < ta.lowest(low,  10)[3]
swept_high_recently = ta.highest(high, 3) > ta.highest(high, 10)[3]

f_obAllowed(_grade) =>
    i_obGrade == "A only" ? _grade == "A" : i_obGrade == "A+B" ? (_grade == "A" or _grade == "B") : true

// Bullish OB — track ALWAYS so confluence works; show only when i_showOB
if bullBOS and close[1] < open[1]
    grade = (swept_low_recently and displacement) ? "A" : displacement ? "B" : "C"
    if f_obAllowed(grade)
        bgC = i_showOB ? c_obBull : color(na)
        bdC = i_showOB ? color.new(#1976d2, 30) : color(na)
        txt = i_showOB ? "OB " + grade : ""
        bx = box.new(bar_index[1], high[1], bar_index + 5, low[1], bgcolor = bgC, border_color = bdC, border_width = 1, text = txt, text_color = color.white, text_size = size.tiny, text_halign = text.align_left)
        ob = OB.new(bx, high[1], low[1], true, grade, false)
        array.push(obs, ob)
        if array.size(obs) > i_obMaxBoxes
            old = array.shift(obs)
            box.delete(old.bx)

// Bearish OB — same pattern
if bearBOS and close[1] > open[1]
    grade = (swept_high_recently and displacement) ? "A" : displacement ? "B" : "C"
    if f_obAllowed(grade)
        bgC = i_showOB ? c_obBear : color(na)
        bdC = i_showOB ? color.new(#f57c00, 30) : color(na)
        txt = i_showOB ? "OB " + grade : ""
        bx = box.new(bar_index[1], high[1], bar_index + 5, low[1], bgcolor = bgC, border_color = bdC, border_width = 1, text = txt, text_color = color.white, text_size = size.tiny, text_halign = text.align_left)
        ob = OB.new(bx, high[1], low[1], false, grade, false)
        array.push(obs, ob)
        if array.size(obs) > i_obMaxBoxes
            old = array.shift(obs)
            box.delete(old.bx)

// Extend / mitigate OBs (iterate backwards via reverse index so removals are safe)
if array.size(obs) > 0
    n_obs = array.size(obs)
    for i = 0 to n_obs - 1
        idx = n_obs - 1 - i
        if idx < array.size(obs)
            ob = array.get(obs, idx)
            if not ob.mitigated
                box.set_right(ob.bx, bar_index + 2)
                mit = ob.bull ? (low <= ob.bot) : (high >= ob.top)
                if mit
                    ob.mitigated := true
                    if i_obMitigate
                        box.delete(ob.bx)
                        array.remove(obs, idx)
                    else
                        box.set_bgcolor(ob.bx, color.new(color.gray, 90))

f_inBullOB() =>
    found = false
    n = array.size(obs)
    if n > 0
        for j = 0 to n - 1
            ob = array.get(obs, j)
            if ob.bull and not ob.mitigated and low <= ob.top and low >= ob.bot
                found := true
    found

f_inBearOB() =>
    found = false
    n = array.size(obs)
    if n > 0
        for j = 0 to n - 1
            ob = array.get(obs, j)
            if not ob.bull and not ob.mitigated and high >= ob.bot and high <= ob.top
                found := true
    found

// ════════════════════════════════════════════════════════════════════════════════════
//   6. FAIR VALUE GAPS
// ════════════════════════════════════════════════════════════════════════════════════
type FVG
    box   bx
    float top
    float bot
    bool  bull
    bool  mitigated

var array<FVG> fvgs = array.new<FVG>()

bullFVG = low > high[2] and close[1] > open[1]
bearFVG = high < low[2] and close[1] < open[1]

if bullFVG
    bgC = i_showFVG ? c_fvgBull : color(na)
    bdC = i_showFVG ? color.new(#00bcd4, 50) : color(na)
    bx = box.new(bar_index - 2, low, bar_index + 5, high[2], bgcolor = bgC, border_color = bdC, border_width = 1)
    f = FVG.new(bx, low, high[2], true, false)
    array.push(fvgs, f)
    if array.size(fvgs) > i_fvgMaxBoxes
        old = array.shift(fvgs)
        box.delete(old.bx)

if bearFVG
    bgC = i_showFVG ? c_fvgBear : color(na)
    bdC = i_showFVG ? color.new(#ff9800, 50) : color(na)
    bx = box.new(bar_index - 2, low[2], bar_index + 5, high, bgcolor = bgC, border_color = bdC, border_width = 1)
    f = FVG.new(bx, low[2], high, false, false)
    array.push(fvgs, f)
    if array.size(fvgs) > i_fvgMaxBoxes
        old = array.shift(fvgs)
        box.delete(old.bx)

if array.size(fvgs) > 0
    n_fvg = array.size(fvgs)
    for i = 0 to n_fvg - 1
        idx = n_fvg - 1 - i
        if idx < array.size(fvgs)
            fv = array.get(fvgs, idx)
            if not fv.mitigated
                box.set_right(fv.bx, bar_index + 2)
                filled = fv.bull ? (low <= fv.bot) : (high >= fv.top)
                if filled
                    fv.mitigated := true
                    if i_fvgMitigate
                        box.delete(fv.bx)
                        array.remove(fvgs, idx)
                    else
                        box.set_bgcolor(fv.bx, color.new(color.gray, 92))

f_inBullFVG() =>
    found = false
    n = array.size(fvgs)
    if n > 0
        for j = 0 to n - 1
            fv = array.get(fvgs, j)
            if fv.bull and not fv.mitigated and low <= fv.top and low >= fv.bot
                found := true
    found

f_inBearFVG() =>
    found = false
    n = array.size(fvgs)
    if n > 0
        for j = 0 to n - 1
            fv = array.get(fvgs, j)
            if not fv.bull and not fv.mitigated and high >= fv.bot and high <= fv.top
                found := true
    found

// ════════════════════════════════════════════════════════════════════════════════════
//   7. LIQUIDITY POOLS (BSL / SSL) + SWEEP DETECTION
// ════════════════════════════════════════════════════════════════════════════════════
type Liq
    line  ln
    float lvl
    int   bar
    bool  buyside
    bool  swept
    int   grade        // 1 = single pivot, 2 = equal H/L pair, 3 = 3+ equal,
                       // 4 = matches PDH/PDL, 5 = matches PWH/PWL/PMH/PML

// Array MUST be declared before any function that references it (Pine v6 forbids
// forward references to arrays inside user-defined functions).
var array<Liq> liqs = array.new<Liq>()

// Grade a fresh liquidity level by checking how many existing pivots are within
// tolerance and whether it aligns with a key HTF level.
f_gradeLiq(_lvl, _isBuyside) =>
    int g = 1
    tol = atr14 * 0.25
    cnt = 0
    if array.size(liqs) > 0
        for j = 0 to array.size(liqs) - 1
            lq = array.get(liqs, j)
            if lq.buyside == _isBuyside and math.abs(lq.lvl - _lvl) <= tol
                cnt := cnt + 1
    if cnt >= 1
        g := 2
    if cnt >= 2
        g := 3
    if _isBuyside
        if (not na(pdHigh) and math.abs(_lvl - pdHigh) <= tol) or (not na(dHigh) and math.abs(_lvl - dHigh) <= tol)
            g := math.max(g, 4)
        if (not na(pwHigh) and math.abs(_lvl - pwHigh) <= tol) or (not na(pmHigh) and math.abs(_lvl - pmHigh) <= tol) or (not na(wHigh) and math.abs(_lvl - wHigh) <= tol)
            g := math.max(g, 5)
    else
        if (not na(pdLow) and math.abs(_lvl - pdLow) <= tol) or (not na(dLow) and math.abs(_lvl - dLow) <= tol)
            g := math.max(g, 4)
        if (not na(pwLow) and math.abs(_lvl - pwLow) <= tol) or (not na(pmLow) and math.abs(_lvl - pmLow) <= tol) or (not na(wLow) and math.abs(_lvl - wLow) <= tol)
            g := math.max(g, 5)
    g

if not na(phRaw)
    grade_ph = f_gradeLiq(phRaw, true)
    lcol     = i_showLiq ? color.new(c_liqBuy, grade_ph >= 4 ? 20 : 60) : color(na)
    width_ph = grade_ph >= 4 ? 2 : 1
    ln = line.new(bar_index - i_pivotLen, phRaw, bar_index + 5, phRaw, color = lcol, style = line.style_dotted, width = width_ph)
    array.push(liqs, Liq.new(ln, phRaw, bar_index - i_pivotLen, true, false, grade_ph))

if not na(plRaw)
    grade_pl = f_gradeLiq(plRaw, false)
    lcol     = i_showLiq ? color.new(c_liqSell, grade_pl >= 4 ? 20 : 60) : color(na)
    width_pl = grade_pl >= 4 ? 2 : 1
    ln = line.new(bar_index - i_pivotLen, plRaw, bar_index + 5, plRaw, color = lcol, style = line.style_dotted, width = width_pl)
    array.push(liqs, Liq.new(ln, plRaw, bar_index - i_pivotLen, false, false, grade_pl))

// Sweep detection + line management
justSweptSSL    = false
justSweptBSL    = false
var int   lastSSLSweepGrade = 0
var int   lastBSLSweepGrade = 0

if array.size(liqs) > 0
    n_liq = array.size(liqs)
    for i = 0 to n_liq - 1
        idx = n_liq - 1 - i
        if idx < array.size(liqs)
            lq = array.get(liqs, idx)
            if not lq.swept
                line.set_x2(lq.ln, bar_index + 2)
                if lq.buyside and high > lq.lvl and close < lq.lvl
                    lq.swept := true
                    justSweptBSL := true
                    lastBSLSweepGrade := lq.grade
                    line.set_color(lq.ln, color.new(c_liqBuy, 30))
                    line.set_style(lq.ln, line.style_solid)
                    if i_showSweep
                        label.new(bar_index, high, "x BSL G" + str.tostring(lq.grade), color = c_liqBuy, textcolor = color.white, style = label.style_label_down, size = size.tiny)
                else if not lq.buyside and low < lq.lvl and close > lq.lvl
                    lq.swept := true
                    justSweptSSL := true
                    lastSSLSweepGrade := lq.grade
                    line.set_color(lq.ln, color.new(c_liqSell, 30))
                    line.set_style(lq.ln, line.style_solid)
                    if i_showSweep
                        label.new(bar_index, low, "x SSL G" + str.tostring(lq.grade), color = c_liqSell, textcolor = color.white, style = label.style_label_up, size = size.tiny)

// Cap line count: drop oldest swept line if over cap
if array.size(liqs) > i_liqMax * 2 and array.size(liqs) > 0
    for i = 0 to array.size(liqs) - 1
        if i >= array.size(liqs)
            break
        lq = array.get(liqs, i)
        if lq.swept
            line.delete(lq.ln)
            array.remove(liqs, i)
            break

// Track recent sweep memory (5-bar window)
var int lastSSLSweepBar = na
var int lastBSLSweepBar = na
if justSweptSSL
    lastSSLSweepBar := bar_index
if justSweptBSL
    lastBSLSweepBar := bar_index

recentSSLSweep = not na(lastSSLSweepBar) and (bar_index - lastSSLSweepBar) <= i_sweepMemBars
recentBSLSweep = not na(lastBSLSweepBar) and (bar_index - lastBSLSweepBar) <= i_sweepMemBars

// Inducement filter: a "major" sweep is grade >= 3 (equal H/L pair, PDH/PDL, PWH/PWL).
// Grade 1-2 sweeps (single isolated pivots) are likely inducement / fake sweeps.
sslSweepMajor = recentSSLSweep and lastSSLSweepGrade >= 3
bslSweepMajor = recentBSLSweep and lastBSLSweepGrade >= 3

// ════════════════════════════════════════════════════════════════════════════════════
//   8. PREMIUM / DISCOUNT DEALING RANGE + OTE
// ════════════════════════════════════════════════════════════════════════════════════
// Session-based AM range
var float amSessHi = na
var float amSessLo = na
inAM = f_inSession(i_sessAM)
if inAM and not inAM[1]
    amSessHi := high
    amSessLo := low
else if inAM
    amSessHi := math.max(nz(amSessHi, high), high)
    amSessLo := math.min(nz(amSessLo, low),  low)

float pdHi = na
float pdLo = na
if i_pdSource == "Weekly"
    pdHi := wHigh
    pdLo := wLow
else if i_pdSource == "Session"
    pdHi := amSessHi
    pdLo := amSessLo
else
    pdHi := dHigh
    pdLo := dLow

pdMid   = na(pdHi) or na(pdLo) ? na : (pdHi + pdLo) / 2
pdRange = na(pdHi) or na(pdLo) ? na : pdHi - pdLo

inDiscount = not na(pdMid) and close < pdMid
inPremium  = not na(pdMid) and close > pdMid

// OTE zone (0.62 - 0.79) — buy zone above pdLo, sell zone below pdHi
oteBuyLo  = na(pdRange) ? na : pdLo + pdRange * 0.62
oteBuyHi  = na(pdRange) ? na : pdLo + pdRange * 0.79
oteSellLo = na(pdRange) ? na : pdHi - pdRange * 0.79
oteSellHi = na(pdRange) ? na : pdHi - pdRange * 0.62

inBuyOTE  = not na(oteBuyLo)  and close >= oteBuyLo  and close <= oteBuyHi  and inDiscount
inSellOTE = not na(oteSellLo) and close >= oteSellLo and close <= oteSellHi and inPremium

// Plot premium/discount lines
plot(i_showPD ? pdHi  : na, "Range High",   color = color.new(c_bear, 40),   style = plot.style_linebr)
plot(i_showPD ? pdLo  : na, "Range Low",    color = color.new(c_bull, 40),   style = plot.style_linebr)
plot(i_showPD ? pdMid : na, "Equilibrium",  color = color.new(color.gray, 30), style = plot.style_linebr)

p_pdHi  = plot(i_showPD ? pdHi  : na, "_pdHi",  display = display.none)
p_pdMid = plot(i_showPD ? pdMid : na, "_pdMid", display = display.none)
p_pdLo  = plot(i_showPD ? pdLo  : na, "_pdLo",  display = display.none)
fill(p_pdHi,  p_pdMid, color = c_premium,  title = "Premium Zone")
fill(p_pdMid, p_pdLo,  color = c_discount, title = "Discount Zone")

// ════════════════════════════════════════════════════════════════════════════════════
//   9. ICT MACRO SESSIONS (NSE IST)
// ════════════════════════════════════════════════════════════════════════════════════
f_drawSession(_inSess, _color, _name, _show) =>
    var box   sb    = na
    var line  hl    = na
    var line  ll    = na
    var float hv    = na
    var float lv    = na
    var bool  wasIn = false
    started = _show and _inSess and not wasIn
    ongoing = _show and _inSess and wasIn and not na(sb)
    if started
        sb := box.new(bar_index, high, bar_index, low, bgcolor = _color, border_color = color.new(_color, 50), border_width = 1, text = _name, text_color = color.white, text_size = size.tiny, text_halign = text.align_left)
        hv := high
        lv := low
        hl := line.new(bar_index, high, bar_index, high, color = color.new(_color, 30), width = 1)
        ll := line.new(bar_index, low,  bar_index, low,  color = color.new(_color, 30), width = 1)
    else if ongoing
        hv := math.max(nz(hv, high), high)
        lv := math.min(nz(lv, low),  low)
        box.set_top(sb, hv)
        box.set_bottom(sb, lv)
        box.set_right(sb, bar_index)
        if not na(hl)
            line.set_xy2(hl, bar_index + 5, hv)
        if not na(ll)
            line.set_xy2(ll, bar_index + 5, lv)
    wasIn := _inSess
    nz(hv, 0.0)

inMid    = f_inSession(i_sessMid)
inLunch  = f_inSession(i_sessLunch)
inPM     = f_inSession(i_sessPM)
inExpiry = f_inSession(i_sessExpiry)

_amDrew     = f_drawSession(inAM,     c_sessAM,     "AM Macro", i_useSessions)
_midDrew    = f_drawSession(inMid,    c_sessMid,    "Mid",      i_useSessions)
_lunchDrew  = f_drawSession(inLunch,  c_sessLunch,  "Lunch",    i_useSessions)
_pmDrew     = f_drawSession(inPM,     c_sessPM,     "PM Macro", i_useSessions)
_expiryDrew = f_drawSession(inExpiry, c_sessExpiry, "Expiry",   i_useSessions)

sessionOK = i_avoidLunch ? not inLunch : true

// ════════════════════════════════════════════════════════════════════════════════════
//   10. WEEKLY PROFILE BIAS
// ════════════════════════════════════════════════════════════════════════════════════
weeklyBullBias = not na(pwHigh) and not na(pwLow) and close > (pwHigh + pwLow) / 2
weeklyBearBias = not na(pwHigh) and not na(pwLow) and close < (pwHigh + pwLow) / 2

plot(i_showWeekly ? wHigh : na, "Weekly High", color = color.new(c_bear, 70),       style = plot.style_linebr, linewidth = 1)
plot(i_showWeekly ? wLow  : na, "Weekly Low",  color = color.new(c_bull, 70),       style = plot.style_linebr, linewidth = 1)
plot(i_showWeekly ? wOpen : na, "Weekly Open", color = color.new(color.orange, 70), style = plot.style_linebr, linewidth = 1)

// ════════════════════════════════════════════════════════════════════════════════════
//   11. CONFLUENCE SCORING ENGINE
// ════════════════════════════════════════════════════════════════════════════════════
buy_htf    = i_useHTFBias ? htfBull : true
buy_sweep  = i_useInducement ? sslSweepMajor : recentSSLSweep
buy_struct = recentBullStruct                       // memory-based: setup stays armed for N bars after BOS/CHoCH
buy_ob     = f_inBullOB()
buy_fvg    = f_inBullFVG()
buy_pd     = i_useOTE ? inBuyOTE : inDiscount
buy_vol    = volOK
buy_bar    = i_requireBarConf ? close > open : true // bullish reaction bar at the OB/FVG

buyScore = (buy_htf ? 1 : 0) + (buy_sweep ? 1 : 0) + (buy_struct ? 1 : 0) + (buy_ob ? 1 : 0) + (buy_fvg ? 1 : 0) + (buy_pd ? 1 : 0) + (buy_vol ? 1 : 0)

sell_htf    = i_useHTFBias ? htfBear : true
sell_sweep  = i_useInducement ? bslSweepMajor : recentBSLSweep
sell_struct = recentBearStruct
sell_ob     = f_inBearOB()
sell_fvg    = f_inBearFVG()
sell_pd     = i_useOTE ? inSellOTE : inPremium
sell_vol    = volOK
sell_bar    = i_requireBarConf ? close < open : true

sellScore = (sell_htf ? 1 : 0) + (sell_sweep ? 1 : 0) + (sell_struct ? 1 : 0) + (sell_ob ? 1 : 0) + (sell_fvg ? 1 : 0) + (sell_pd ? 1 : 0) + (sell_vol ? 1 : 0)

// Pre-movement trigger:
//   sweep already happened (memory) AND structure already shifted (memory)
//   AND price has now returned to an OB or FVG AND a reaction bar prints
//   → entry on the retrace, BEFORE the next leg
buy_core_trigger  = buy_sweep  and buy_struct  and (buy_ob  or buy_fvg)  and buy_bar
sell_core_trigger = sell_sweep and sell_struct and (sell_ob or sell_fvg) and sell_bar

buyCandidate  = sessionOK and buy_core_trigger  and buyScore  >= i_minScore and regimeAllowsBuy
sellCandidate = sessionOK and sell_core_trigger and sellScore >= i_minScore and regimeAllowsSell

// ════════════════════════════════════════════════════════════════════════════════════
//   12. ENTRY / SL / TP CALCULATION
//   Calc functions are called every bar (Pine v6 best practice — silences the
//   "should be called on each calculation for consistency" warning) and the
//   results are only consumed inside the signal-fired branches below.
// ════════════════════════════════════════════════════════════════════════════════════
f_calcSL_buy() =>
    float sl = 0.0
    if i_slMode == "Structure"
        sl := ta.lowest(low, 5) * (1 - i_slBuffer / 100)
    else if i_slMode == "ATR"
        sl := close - atr14 * i_slATR
    else
        sl := close * (1 - i_slFixedPct / 100)
    sl

f_calcSL_sell() =>
    float sl = 0.0
    if i_slMode == "Structure"
        sl := ta.highest(high, 5) * (1 + i_slBuffer / 100)
    else if i_slMode == "ATR"
        sl := close + atr14 * i_slATR
    else
        sl := close * (1 + i_slFixedPct / 100)
    sl

// Always evaluate (Pine v6 consistency requirement)
buySLcalc  = f_calcSL_buy()
sellSLcalc = f_calcSL_sell()

// ════════════════════════════════════════════════════════════════════════════════════
//   12b. ADAPTIVE TARGETS — project TP1 / TP2 / TP3 to actual price-action levels
//   For BUYS: scan above entry for unswept BSL pools, opposing (bear) OBs / FVGs,
//   and HTF key levels (PDH, PWH, PMH, daily/weekly mid). Sort ascending and pick
//   the three nearest. Falls back to R-multiples when the structure stack is short.
// ════════════════════════════════════════════════════════════════════════════════════

f_collectBuyTargets(_entry) =>
    arr = array.new<float>()
    if array.size(liqs) > 0
        for j = 0 to array.size(liqs) - 1
            lq = array.get(liqs, j)
            if lq.buyside and not lq.swept and lq.lvl > _entry
                array.push(arr, lq.lvl)
    if array.size(obs) > 0
        for j = 0 to array.size(obs) - 1
            ob = array.get(obs, j)
            if not ob.bull and not ob.mitigated and ob.bot > _entry
                array.push(arr, ob.bot)
    if array.size(fvgs) > 0
        for j = 0 to array.size(fvgs) - 1
            fv = array.get(fvgs, j)
            if not fv.bull and not fv.mitigated and fv.bot > _entry
                array.push(arr, fv.bot)
    if i_useKeyAsTP
        if not na(pdHigh) and pdHigh > _entry
            array.push(arr, pdHigh)
        if not na(dHigh)  and dHigh  > _entry and dHigh != pdHigh
            array.push(arr, dHigh)
        if not na(pwHigh) and pwHigh > _entry
            array.push(arr, pwHigh)
        if not na(wHigh)  and wHigh  > _entry and wHigh != pwHigh
            array.push(arr, wHigh)
        if not na(pmHigh) and pmHigh > _entry
            array.push(arr, pmHigh)
    if not na(pdMid) and pdMid > _entry
        array.push(arr, pdMid)
    array.sort(arr, order.ascending)
    arr

f_collectSellTargets(_entry) =>
    arr = array.new<float>()
    if array.size(liqs) > 0
        for j = 0 to array.size(liqs) - 1
            lq = array.get(liqs, j)
            if not lq.buyside and not lq.swept and lq.lvl < _entry
                array.push(arr, lq.lvl)
    if array.size(obs) > 0
        for j = 0 to array.size(obs) - 1
            ob = array.get(obs, j)
            if ob.bull and not ob.mitigated and ob.top < _entry
                array.push(arr, ob.top)
    if array.size(fvgs) > 0
        for j = 0 to array.size(fvgs) - 1
            fv = array.get(fvgs, j)
            if fv.bull and not fv.mitigated and fv.top < _entry
                array.push(arr, fv.top)
    if i_useKeyAsTP
        if not na(pdLow) and pdLow < _entry
            array.push(arr, pdLow)
        if not na(dLow)  and dLow  < _entry and dLow != pdLow
            array.push(arr, dLow)
        if not na(pwLow) and pwLow < _entry
            array.push(arr, pwLow)
        if not na(wLow)  and wLow  < _entry and wLow != pwLow
            array.push(arr, wLow)
        if not na(pmLow) and pmLow < _entry
            array.push(arr, pmLow)
    if not na(pdMid) and pdMid < _entry
        array.push(arr, pdMid)
    array.sort(arr, order.descending)
    arr

// Pick TP1/TP2/TP3 from a sorted array, with R-multiple fallback. Also enforces a
// minimum distance from entry so we don't put TP1 right on top of the entry bar.
f_pickTPs(_isBuy, _entry, _sl, _arr) =>
    rk      = _isBuy ? _entry - _sl : _sl - _entry
    minDist = rk * 0.5                                 // TP1 must be at least 0.5R away
    fb1     = _isBuy ? _entry + rk * i_tp1R : _entry - rk * i_tp1R
    fb2     = _isBuy ? _entry + rk * i_tp2R : _entry - rk * i_tp2R
    fb3     = _isBuy ? _entry + rk * i_tp3R : _entry - rk * i_tp3R
    float t1 = na
    float t2 = na
    float t3 = na
    n = array.size(_arr)
    picked = array.new<float>()
    for j = 0 to n - 1
        v = array.get(_arr, j)
        d = _isBuy ? v - _entry : _entry - v
        if d >= minDist
            // de-dup with tolerance
            ok = true
            if array.size(picked) > 0
                for k = 0 to array.size(picked) - 1
                    if math.abs(array.get(picked, k) - v) <= atr14 * 0.3
                        ok := false
                        break
            if ok
                array.push(picked, v)
                if array.size(picked) >= 3
                    break
    p = array.size(picked)
    t1 := p >= 1 ? array.get(picked, 0) : fb1
    t2 := p >= 2 ? array.get(picked, 1) : fb2
    t3 := p >= 3 ? array.get(picked, 2) : fb3
    // Guarantee t1 < t2 < t3 for buys (and reverse for sells)
    if _isBuy
        if t2 <= t1
            t2 := math.max(t2, fb2)
        if t3 <= t2
            t3 := math.max(t3, fb3)
    else
        if t2 >= t1
            t2 := math.min(t2, fb2)
        if t3 >= t2
            t3 := math.min(t3, fb3)
    [t1, t2, t3]

// ════════════════════════════════════════════════════════════════════════════════════
//   13. TRADE PLAN STATE MACHINE
//   At most ONE active trade plan at a time. New same-direction signals are
//   suppressed while a trade is active. Opposite-direction signals replace the
//   plan. Plan auto-clears when SL or TP3 is hit.
// ════════════════════════════════════════════════════════════════════════════════════
var line  tpLnEntry = na
var line  tpLnSL    = na
var line  tpLnTP1   = na
var line  tpLnTP2   = na
var line  tpLnTP3   = na
var label tpLbEntry = na
var label tpLbSL    = na
var label tpLbTP1   = na
var label tpLbTP2   = na
var label tpLbTP3   = na
var label tpLbSig   = na              // big BUY/SELL marker on signal bar

var bool  tpActive  = false
var bool  tpIsBuy   = false
var float tpEntry   = na
var float tpSL      = na
var float tpTP1     = na
var float tpTP2     = na
var float tpTP3     = na
var int   tpBar     = na
var int   tpScore   = na

// Pine v6 forbids user-defined functions from writing to global vars, so this
// function only deletes the drawing objects. Each call site is responsible for
// flipping tpActive itself.
f_clearPlanDrawings() =>
    line.delete(tpLnEntry)
    line.delete(tpLnSL)
    line.delete(tpLnTP1)
    line.delete(tpLnTP2)
    line.delete(tpLnTP3)
    label.delete(tpLbEntry)
    label.delete(tpLbSL)
    label.delete(tpLbTP1)
    label.delete(tpLbTP2)
    label.delete(tpLbTP3)
    label.delete(tpLbSig)
    0

// Signals can fire only when no same-direction trade is active.
// Opposite-direction signal replaces the existing plan.
buySignal  = buyCandidate  and (not tpActive or not tpIsBuy)
sellSignal = sellCandidate and (not tpActive or tpIsBuy)

// Pre-fire: clear an existing plan if new opposite signal arrives
if (buySignal and tpActive and not tpIsBuy) or (sellSignal and tpActive and tpIsBuy)
    f_clearPlanDrawings()
    tpActive := false

if buySignal
    f_clearPlanDrawings()             // wipe any stale state defensively
    tpActive := false
    tpIsBuy := true
    tpEntry := close
    tpSL    := buySLcalc
    rk       = tpEntry - tpSL
    if i_useAdaptiveTP
        targetsBuy = f_collectBuyTargets(tpEntry)
        [t1b, t2b, t3b] = f_pickTPs(true, tpEntry, tpSL, targetsBuy)
        tpTP1 := t1b
        tpTP2 := t2b
        tpTP3 := t3b
    else
        tpTP1 := tpEntry + rk * i_tp1R
        tpTP2 := tpEntry + rk * i_tp2R
        tpTP3 := tpEntry + rk * i_tp3R
    tpBar   := bar_index
    tpScore := buyScore
    tpActive := true
    col_entry = c_bull
    col_tp    = c_tpBuy
    tpLnEntry := line.new(tpBar, tpEntry, tpBar + 1, tpEntry, color = col_entry, width = 2, style = line.style_solid,  extend = extend.right)
    tpLnSL    := line.new(tpBar, tpSL,    tpBar + 1, tpSL,    color = c_slLine,  width = 2, style = line.style_dashed, extend = extend.right)
    tpLnTP1   := line.new(tpBar, tpTP1,   tpBar + 1, tpTP1,   color = color.new(col_tp, 20), width = 1, style = line.style_dashed, extend = extend.right)
    tpLnTP2   := line.new(tpBar, tpTP2,   tpBar + 1, tpTP2,   color = color.new(col_tp, 40), width = 1, style = line.style_dashed, extend = extend.right)
    tpLnTP3   := line.new(tpBar, tpTP3,   tpBar + 1, tpTP3,   color = color.new(col_tp, 60), width = 1, style = line.style_dashed, extend = extend.right)
    tpLbSig   := label.new(tpBar, low, "BUY  " + str.tostring(tpScore) + "/7", color = c_bull, textcolor = color.white, style = label.style_label_up, size = size.normal)
    tpLbEntry := label.new(bar_index + 1, tpEntry, "ENTRY " + str.tostring(tpEntry, format.mintick), color = col_entry, textcolor = color.white, style = label.style_label_left, size = size.small)
    tpLbSL    := label.new(bar_index + 1, tpSL,    "SL "    + str.tostring(tpSL,    format.mintick), color = c_slLine,  textcolor = color.white, style = label.style_label_left, size = size.small)
    tpLbTP1   := label.new(bar_index + 1, tpTP1,   "TP1 "   + str.tostring(tpTP1,   format.mintick), color = col_tp,    textcolor = color.white, style = label.style_label_left, size = size.small)
    tpLbTP2   := label.new(bar_index + 1, tpTP2,   "TP2 "   + str.tostring(tpTP2,   format.mintick), color = color.new(col_tp, 30), textcolor = color.white, style = label.style_label_left, size = size.small)
    tpLbTP3   := label.new(bar_index + 1, tpTP3,   "TP3 "   + str.tostring(tpTP3,   format.mintick), color = color.new(col_tp, 50), textcolor = color.white, style = label.style_label_left, size = size.small)
    // Rich dynamic alert with all levels (and position size if enabled)
    posLineB = i_useRiskCalc ? "  Size: " + str.tostring(f_positionSize(tpEntry, tpSL), "#.##") + " (risk " + str.tostring(i_riskPct, "#.#") + "%)" : ""
    alert("ICT MASTER PRO  BUY  " + syminfo.ticker + "  Entry " + str.tostring(tpEntry, format.mintick) + "  SL " + str.tostring(tpSL, format.mintick) + "  TP1 " + str.tostring(tpTP1, format.mintick) + "  TP2 " + str.tostring(tpTP2, format.mintick) + "  TP3 " + str.tostring(tpTP3, format.mintick) + "  Score " + str.tostring(tpScore) + "/7" + posLineB, alert.freq_once_per_bar_close)

if sellSignal
    f_clearPlanDrawings()
    tpActive := false
    tpIsBuy := false
    tpEntry := close
    tpSL    := sellSLcalc
    rk       = tpSL - tpEntry
    if i_useAdaptiveTP
        targetsSell = f_collectSellTargets(tpEntry)
        [t1s, t2s, t3s] = f_pickTPs(false, tpEntry, tpSL, targetsSell)
        tpTP1 := t1s
        tpTP2 := t2s
        tpTP3 := t3s
    else
        tpTP1 := tpEntry - rk * i_tp1R
        tpTP2 := tpEntry - rk * i_tp2R
        tpTP3 := tpEntry - rk * i_tp3R
    tpBar   := bar_index
    tpScore := sellScore
    tpActive := true
    col_entry = c_bear
    col_tp    = c_tpSell
    tpLnEntry := line.new(tpBar, tpEntry, tpBar + 1, tpEntry, color = col_entry, width = 2, style = line.style_solid,  extend = extend.right)
    tpLnSL    := line.new(tpBar, tpSL,    tpBar + 1, tpSL,    color = c_slLine,  width = 2, style = line.style_dashed, extend = extend.right)
    tpLnTP1   := line.new(tpBar, tpTP1,   tpBar + 1, tpTP1,   color = color.new(col_tp, 20), width = 1, style = line.style_dashed, extend = extend.right)
    tpLnTP2   := line.new(tpBar, tpTP2,   tpBar + 1, tpTP2,   color = color.new(col_tp, 40), width = 1, style = line.style_dashed, extend = extend.right)
    tpLnTP3   := line.new(tpBar, tpTP3,   tpBar + 1, tpTP3,   color = color.new(col_tp, 60), width = 1, style = line.style_dashed, extend = extend.right)
    tpLbSig   := label.new(tpBar, high, "SELL  " + str.tostring(tpScore) + "/7", color = c_bear, textcolor = color.white, style = label.style_label_down, size = size.normal)
    tpLbEntry := label.new(bar_index + 1, tpEntry, "ENTRY " + str.tostring(tpEntry, format.mintick), color = col_entry, textcolor = color.white, style = label.style_label_left, size = size.small)
    tpLbSL    := label.new(bar_index + 1, tpSL,    "SL "    + str.tostring(tpSL,    format.mintick), color = c_slLine,  textcolor = color.white, style = label.style_label_left, size = size.small)
    tpLbTP1   := label.new(bar_index + 1, tpTP1,   "TP1 "   + str.tostring(tpTP1,   format.mintick), color = col_tp,    textcolor = color.white, style = label.style_label_left, size = size.small)
    tpLbTP2   := label.new(bar_index + 1, tpTP2,   "TP2 "   + str.tostring(tpTP2,   format.mintick), color = color.new(col_tp, 30), textcolor = color.white, style = label.style_label_left, size = size.small)
    tpLbTP3   := label.new(bar_index + 1, tpTP3,   "TP3 "   + str.tostring(tpTP3,   format.mintick), color = color.new(col_tp, 50), textcolor = color.white, style = label.style_label_left, size = size.small)
    posLineS = i_useRiskCalc ? "  Size: " + str.tostring(f_positionSize(tpEntry, tpSL), "#.##") + " (risk " + str.tostring(i_riskPct, "#.#") + "%)" : ""
    alert("ICT MASTER PRO  SELL  " + syminfo.ticker + "  Entry " + str.tostring(tpEntry, format.mintick) + "  SL " + str.tostring(tpSL, format.mintick) + "  TP1 " + str.tostring(tpTP1, format.mintick) + "  TP2 " + str.tostring(tpTP2, format.mintick) + "  TP3 " + str.tostring(tpTP3, format.mintick) + "  Score " + str.tostring(tpScore) + "/7" + posLineS, alert.freq_once_per_bar_close)

// Auto-clear plan when SL or final TP is hit (use bar's high/low for trigger)
if tpActive
    if tpIsBuy and (low <= tpSL or high >= tpTP3)
        f_clearPlanDrawings()
        tpActive := false
    else if not tpIsBuy and (high >= tpSL or low <= tpTP3)
        f_clearPlanDrawings()
        tpActive := false

// Slide labels to the right edge of the chart so they always stay visible
// regardless of zoom / scroll. Runs every bar so the labels track the latest
// bar continuously.
if tpActive and not na(tpLbEntry)
    rightX = bar_index + 1
    label.set_x(tpLbEntry, rightX)
    label.set_x(tpLbSL,    rightX)
    label.set_x(tpLbTP1,   rightX)
    label.set_x(tpLbTP2,   rightX)
    label.set_x(tpLbTP3,   rightX)

plotshape(buySignal,  title = "Buy Signal",  location = location.belowbar, color = c_bull, style = shape.triangleup,   size = size.tiny)
plotshape(sellSignal, title = "Sell Signal", location = location.abovebar, color = c_bear, style = shape.triangledown, size = size.tiny)

// Compatibility shims so the dashboard "Last Signal / Active Plan / Targets"
// cells (which were written against the old buyEntry / sellEntry / etc vars)
// keep working without a second rewrite.
buyEntry  = tpActive and     tpIsBuy ? tpEntry : na
buySL     = tpActive and     tpIsBuy ? tpSL    : na
buyTP1    = tpActive and     tpIsBuy ? tpTP1   : na
buyTP2    = tpActive and     tpIsBuy ? tpTP2   : na
buyTP3    = tpActive and     tpIsBuy ? tpTP3   : na
buyBar    = tpActive and     tpIsBuy ? tpBar   : na
sellEntry = tpActive and not tpIsBuy ? tpEntry : na
sellSL    = tpActive and not tpIsBuy ? tpSL    : na
sellTP1   = tpActive and not tpIsBuy ? tpTP1   : na
sellTP2   = tpActive and not tpIsBuy ? tpTP2   : na
sellTP3   = tpActive and not tpIsBuy ? tpTP3   : na
sellBar   = tpActive and not tpIsBuy ? tpBar   : na

// ════════════════════════════════════════════════════════════════════════════════════
//   13b. PERFORMANCE TRACKER
//   Logs every fired signal as a Trade and updates each open trade per-bar.
//   First level hit (TP1 / TP2 / TP3 / SL) is the trade's outcome. Stats:
//   win rate (TP1+ hit), average R achieved, max drawdown across the rolling
//   window of the last N closed trades.
// ════════════════════════════════════════════════════════════════════════════════════
type Trade
    int   bar
    bool  isBuy
    float entry
    float sl
    float tp1
    float tp2
    float tp3
    int   outcome      // 0 = open, 1 = TP1, 2 = TP2, 3 = TP3, -1 = SL
    float rResult      // realised R multiple

var array<Trade> trades   = array.new<Trade>()
var int   tradesClosed    = 0
var int   tradesWon       = 0
var int   tradesLost      = 0
var float sumR            = 0.0
var float maxDDR          = 0.0
var float runningR        = 0.0
var float peakR           = 0.0

// Log a new signal
if i_trackPerf and buySignal
    array.push(trades, Trade.new(bar_index, true, tpEntry, tpSL, tpTP1, tpTP2, tpTP3, 0, 0.0))
if i_trackPerf and sellSignal
    array.push(trades, Trade.new(bar_index, false, tpEntry, tpSL, tpTP1, tpTP2, tpTP3, 0, 0.0))

// Update each open trade. Outcome model: the FIRST level reached (TP1, TP2, TP3
// or SL) closes the trade and finalises its R. Same-bar tie -> TP wins (price
// printed the favorable level intra-bar before reversing).
if i_trackPerf and array.size(trades) > 0
    for j = 0 to array.size(trades) - 1
        if j >= array.size(trades)
            break
        t = array.get(trades, j)
        if t.outcome == 0 and bar_index > t.bar
            risk = t.isBuy ? t.entry - t.sl : t.sl - t.entry
            done = false
            if t.isBuy
                if high >= t.tp3
                    t.outcome := 3
                    t.rResult := (t.tp3 - t.entry) / risk
                    done := true
                else if high >= t.tp2
                    t.outcome := 2
                    t.rResult := (t.tp2 - t.entry) / risk
                    done := true
                else if high >= t.tp1
                    t.outcome := 1
                    t.rResult := (t.tp1 - t.entry) / risk
                    done := true
                else if low <= t.sl
                    t.outcome := -1
                    t.rResult := -1.0
                    done := true
            else
                if low <= t.tp3
                    t.outcome := 3
                    t.rResult := (t.entry - t.tp3) / risk
                    done := true
                else if low <= t.tp2
                    t.outcome := 2
                    t.rResult := (t.entry - t.tp2) / risk
                    done := true
                else if low <= t.tp1
                    t.outcome := 1
                    t.rResult := (t.entry - t.tp1) / risk
                    done := true
                else if high >= t.sl
                    t.outcome := -1
                    t.rResult := -1.0
                    done := true
            if done
                tradesClosed := tradesClosed + 1
                if t.rResult > 0
                    tradesWon  := tradesWon + 1
                else
                    tradesLost := tradesLost + 1
                sumR     := sumR + t.rResult
                runningR := runningR + t.rResult
                peakR    := math.max(peakR, runningR)
                dd       = peakR - runningR
                maxDDR   := math.max(maxDDR, dd)
                if i_showPerfLines
                    perfTxt = t.rResult > 0 ? "+" + str.tostring(t.rResult, "#.##") + "R" : str.tostring(t.rResult, "#.##") + "R"
                    perfBg  = t.rResult > 0 ? color.new(c_bull, 50) : color.new(c_bear, 50)
                    perfStyle = t.isBuy ? label.style_label_down : label.style_label_up
                    perfY   = t.isBuy ? high : low
                    label.new(bar_index, perfY, perfTxt, color = perfBg, textcolor = color.white, style = perfStyle, size = size.tiny)

// Cap trade history length
if i_trackPerf and array.size(trades) > i_perfWindow * 3
    array.shift(trades)

// Rolling window stats — only count the last N closed trades
f_perfStats() =>
    int   wins   = 0
    int   losses = 0
    float rSum   = 0.0
    int   counted = 0
    n = array.size(trades)
    if n > 0
        for k = 0 to n - 1
            if counted >= i_perfWindow
                break
            idx = n - 1 - k
            t = array.get(trades, idx)
            if t.outcome != 0
                if t.rResult > 0
                    wins := wins + 1
                else
                    losses := losses + 1
                rSum := rSum + t.rResult
                counted := counted + 1
    [wins, losses, rSum, counted]

[winsW, lossesW, rSumW, countedW] = f_perfStats()
winRatePct = countedW > 0 ? 100.0 * winsW / countedW : 0.0
avgRWin    = countedW > 0 ? rSumW / countedW : 0.0

// Position-size suggestion (used in alert messages and shown in dashboard)
f_positionSize(_entry, _sl) =>
    risk    = math.abs(_entry - _sl)
    riskAmt = i_account * (i_riskPct / 100)
    risk == 0 ? 0.0 : riskAmt / risk

posSizeBuy  = tpActive and tpIsBuy ?     f_positionSize(tpEntry, tpSL) : 0.0
posSizeSell = tpActive and not tpIsBuy ? f_positionSize(tpEntry, tpSL) : 0.0

// ════════════════════════════════════════════════════════════════════════════════════
//   14. DASHBOARD — at-a-glance ICT context
// ════════════════════════════════════════════════════════════════════════════════════
var table dash = table.new(f_dashPos(), 2, 17, border_width = 1, frame_color = color.new(color.gray, 50))

f_zoneText() =>
    inDiscount ? "DISCOUNT (Buy zone)" : inPremium ? "PREMIUM (Sell zone)" : "EQUILIBRIUM"

f_zoneCol() =>
    inDiscount ? color.new(c_bull, 70) : inPremium ? color.new(c_bear, 70) : color.new(color.gray, 70)

f_oteText() =>
    inBuyOTE ? "BUY OTE (0.62-0.79)" : inSellOTE ? "SELL OTE (0.62-0.79)" : "-"

f_sessName() =>
    inAM ? "AM Macro" : inMid ? "Mid" : inLunch ? "Lunch (avoid)" : inPM ? "PM Macro" : inExpiry ? "Expiry" : "Off-session"

f_sessCol() =>
    inAM ? color.new(c_sessAM, 50) : inMid ? color.new(c_sessMid, 50) : inLunch ? color.new(c_sessLunch, 50) : inPM ? color.new(c_sessPM, 50) : inExpiry ? color.new(c_sessExpiry, 50) : color.new(color.gray, 80)

f_lastSig() =>
    string s = "- (waiting)"
    if not na(buyBar) and (na(sellBar) or buyBar > sellBar)
        s := "BUY @ " + str.tostring(buyEntry, format.mintick)
    else if not na(sellBar) and (na(buyBar) or sellBar > buyBar)
        s := "SELL @ " + str.tostring(sellEntry, format.mintick)
    s

f_lastSigCol() =>
    color c = color.new(color.gray, 80)
    if not na(buyBar) and (na(sellBar) or buyBar > sellBar)
        c := color.new(c_bull, 70)
    else if not na(sellBar) and (na(buyBar) or sellBar > buyBar)
        c := color.new(c_bear, 70)
    c

f_weeklyText() =>
    weeklyBullBias ? "BULLISH (above PW mid)" : weeklyBearBias ? "BEARISH (below PW mid)" : "NEUTRAL"

if i_showDash and barstate.islast
    sz = f_dashSize()
    cellHdr = color.new(color.gray, 70)
    table.cell(dash, 0, 0, "ICT MASTER PRO", text_color = color.white, bgcolor = color.new(#1565c0, 0), text_size = sz)
    table.merge_cells(dash, 0, 0, 1, 0)

    table.cell(dash, 0, 1, "HTF Bias (" + i_htfTF + ")", text_color = color.white, bgcolor = cellHdr, text_size = sz)
    table.cell(dash, 1, 1, htfBiasStr, text_color = color.white, bgcolor = htfBiasCol, text_size = sz)

    table.cell(dash, 0, 2, "Weekly Bias", text_color = color.white, bgcolor = cellHdr, text_size = sz)
    wkBg = weeklyBullBias ? color.new(c_bull, 60) : weeklyBearBias ? color.new(c_bear, 60) : color.new(color.gray, 60)
    table.cell(dash, 1, 2, f_weeklyText(), text_color = color.white, bgcolor = wkBg, text_size = sz)

    table.cell(dash, 0, 3, "Range Zone", text_color = color.white, bgcolor = cellHdr, text_size = sz)
    table.cell(dash, 1, 3, f_zoneText(), text_color = color.white, bgcolor = f_zoneCol(), text_size = sz)

    table.cell(dash, 0, 4, "OTE", text_color = color.white, bgcolor = cellHdr, text_size = sz)
    oteBg = inBuyOTE ? color.new(c_bull, 60) : inSellOTE ? color.new(c_bear, 60) : color.new(color.gray, 80)
    table.cell(dash, 1, 4, f_oteText(), text_color = color.white, bgcolor = oteBg, text_size = sz)

    table.cell(dash, 0, 5, "Session", text_color = color.white, bgcolor = cellHdr, text_size = sz)
    table.cell(dash, 1, 5, f_sessName(), text_color = color.white, bgcolor = f_sessCol(), text_size = sz)

    table.cell(dash, 0, 6, "Recent Sweep", text_color = color.white, bgcolor = cellHdr, text_size = sz)
    sweepTxt = recentSSLSweep ? "SSL x (bullish setup)" : recentBSLSweep ? "BSL x (bearish setup)" : "-"
    sweepCol = recentSSLSweep ? color.new(c_bull, 60) : recentBSLSweep ? color.new(c_bear, 60) : color.new(color.gray, 80)
    table.cell(dash, 1, 6, sweepTxt, text_color = color.white, bgcolor = sweepCol, text_size = sz)

    table.cell(dash, 0, 7, "Volume", text_color = color.white, bgcolor = cellHdr, text_size = sz)
    volBg = volOK ? color.new(c_bull, 60) : color.new(color.gray, 70)
    table.cell(dash, 1, 7, volOK ? "ABOVE AVG" : "below avg", text_color = color.white, bgcolor = volBg, text_size = sz)

    table.cell(dash, 0, 8, "Buy Score", text_color = color.white, bgcolor = cellHdr, text_size = sz)
    buyScoreBg = buyScore >= i_minScore ? color.new(c_bull, 40) : color.new(color.gray, 80)
    table.cell(dash, 1, 8, str.tostring(buyScore) + " / 7", text_color = color.white, bgcolor = buyScoreBg, text_size = sz)

    table.cell(dash, 0, 9, "Sell Score", text_color = color.white, bgcolor = cellHdr, text_size = sz)
    sellScoreBg = sellScore >= i_minScore ? color.new(c_bear, 40) : color.new(color.gray, 80)
    table.cell(dash, 1, 9, str.tostring(sellScore) + " / 7", text_color = color.white, bgcolor = sellScoreBg, text_size = sz)

    table.cell(dash, 0, 10, "Last Signal", text_color = color.white, bgcolor = cellHdr, text_size = sz)
    table.cell(dash, 1, 10, f_lastSig(), text_color = color.white, bgcolor = f_lastSigCol(), text_size = sz)

    activeBuy  = not na(buyBar)  and (na(sellBar) or buyBar  > sellBar)
    activeSell = not na(sellBar) and (na(buyBar)  or sellBar > buyBar)
    table.cell(dash, 0, 11, "Active Plan", text_color = color.white, bgcolor = cellHdr, text_size = sz)
    string planTxt = "-"
    if activeBuy
        planTxt := "E:" + str.tostring(buyEntry, format.mintick) + " SL:" + str.tostring(buySL, format.mintick)
    else if activeSell
        planTxt := "E:" + str.tostring(sellEntry, format.mintick) + " SL:" + str.tostring(sellSL, format.mintick)
    table.cell(dash, 1, 11, planTxt, text_color = color.white, bgcolor = color.new(color.gray, 80), text_size = sz)

    table.cell(dash, 0, 12, "Targets (R)", text_color = color.white, bgcolor = cellHdr, text_size = sz)
    string tpTxt = "-"
    if activeBuy
        tpTxt := "TP1:" + str.tostring(buyTP1, format.mintick) + " TP2:" + str.tostring(buyTP2, format.mintick) + " TP3:" + str.tostring(buyTP3, format.mintick)
    else if activeSell
        tpTxt := "TP1:" + str.tostring(sellTP1, format.mintick) + " TP2:" + str.tostring(sellTP2, format.mintick) + " TP3:" + str.tostring(sellTP3, format.mintick)
    table.cell(dash, 1, 12, tpTxt, text_color = color.white, bgcolor = color.new(color.gray, 80), text_size = sz)

    // Pre-movement awareness: setup armed = sweep + structure are both fresh,
    // we just need price to retrace into an OB/FVG and react.
    buySetupArmed  = recentSSLSweep and recentBullStruct
    sellSetupArmed = recentBSLSweep and recentBearStruct
    string statusTxt = "Scanning..."
    color  statusCol = color.new(#1565c0, 0)
    if buyCandidate
        statusTxt := "BUY READY  (take entry)"
        statusCol := color.new(c_bull, 0)
    else if sellCandidate
        statusTxt := "SELL READY  (take entry)"
        statusCol := color.new(c_bear, 0)
    else if buySetupArmed and (buy_ob or buy_fvg)
        statusTxt := "BUY armed - waiting bar confirm"
        statusCol := color.new(c_bull, 30)
    else if sellSetupArmed and (sell_ob or sell_fvg)
        statusTxt := "SELL armed - waiting bar confirm"
        statusCol := color.new(c_bear, 30)
    else if buySetupArmed
        statusTxt := "Buy setup forming - awaiting retrace"
        statusCol := color.new(c_bull, 60)
    else if sellSetupArmed
        statusTxt := "Sell setup forming - awaiting retrace"
        statusCol := color.new(c_bear, 60)
    else if buyScore >= i_minScore
        statusTxt := "Buy score met - need sweep+struct"
    else if sellScore >= i_minScore
        statusTxt := "Sell score met - need sweep+struct"
    table.cell(dash, 0, 13, "STATUS", text_color = color.white, bgcolor = cellHdr, text_size = sz)
    table.cell(dash, 1, 13, statusTxt, text_color = color.white, bgcolor = statusCol, text_size = sz)

    // Row 14 — Regime
    table.cell(dash, 0, 14, "Regime", text_color = color.white, bgcolor = cellHdr, text_size = sz)
    table.cell(dash, 1, 14, regimeStr + "  (ADX " + str.tostring(adx, "#") + ")", text_color = color.white, bgcolor = regimeCol, text_size = sz)

    // Row 15 — Last sweep quality
    string sweepQTxt = "-"
    color  sweepQCol = color.new(color.gray, 80)
    if recentSSLSweep
        sweepQTxt := "SSL G" + str.tostring(lastSSLSweepGrade) + (lastSSLSweepGrade >= 3 ? " (major)" : " (minor/inducement)")
        sweepQCol := lastSSLSweepGrade >= 3 ? color.new(c_bull, 40) : color.new(#ef6c00, 50)
    else if recentBSLSweep
        sweepQTxt := "BSL G" + str.tostring(lastBSLSweepGrade) + (lastBSLSweepGrade >= 3 ? " (major)" : " (minor/inducement)")
        sweepQCol := lastBSLSweepGrade >= 3 ? color.new(c_bear, 40) : color.new(#ef6c00, 50)
    table.cell(dash, 0, 15, "Sweep Quality", text_color = color.white, bgcolor = cellHdr, text_size = sz)
    table.cell(dash, 1, 15, sweepQTxt, text_color = color.white, bgcolor = sweepQCol, text_size = sz)

    // Row 16 — Performance stats
    string perfTxt = "no closed trades yet"
    color  perfCol = color.new(color.gray, 70)
    if countedW > 0
        perfTxt := "Win " + str.tostring(winRatePct, "#") + "%  Avg " + str.tostring(avgRWin, "#.##") + "R  DD " + str.tostring(maxDDR, "#.##") + "R  (" + str.tostring(countedW) + " trades)"
    if countedW >= 5
        if winRatePct >= 60 and avgRWin > 0
            perfCol := color.new(c_bull, 40)
        else if winRatePct >= 40
            perfCol := color.new(#1565c0, 30)
        else
            perfCol := color.new(c_bear, 40)
    table.cell(dash, 0, 16, "Performance", text_color = color.white, bgcolor = cellHdr, text_size = sz)
    table.cell(dash, 1, 16, perfTxt, text_color = color.white, bgcolor = perfCol, text_size = sz)

// ════════════════════════════════════════════════════════════════════════════════════
//   15. ALERTS
// ════════════════════════════════════════════════════════════════════════════════════
// Entry signals (the actual trade trigger)
alertcondition(buySignal,    title = "ICT Buy Signal",      message = "ICT MASTER PRO: BUY {{ticker}} @ {{close}} - confluence-based entry. Check chart for SL/TP.")
alertcondition(sellSignal,   title = "ICT Sell Signal",     message = "ICT MASTER PRO: SELL {{ticker}} @ {{close}} - confluence-based entry. Check chart for SL/TP.")

// Pre-signal alerts (setup armed, waiting for retrace into OB/FVG)
buySetupArmedAlert  = recentSSLSweep and recentBullStruct and (f_inBullOB() or f_inBullFVG())
sellSetupArmedAlert = recentBSLSweep and recentBearStruct and (f_inBearOB() or f_inBearFVG())
alertcondition(buySetupArmedAlert,  title = "Buy Setup Armed",  message = "ICT: BUY setup armed on {{ticker}} - sweep+CHoCH done, price in OB/FVG. Wait for reaction bar.")
alertcondition(sellSetupArmedAlert, title = "Sell Setup Armed", message = "ICT: SELL setup armed on {{ticker}} - sweep+CHoCH done, price in OB/FVG. Wait for reaction bar.")

// Component alerts
alertcondition(bullCHoCH,    title = "Bullish CHoCH",       message = "ICT: Bullish CHoCH on {{ticker}} {{interval}}")
alertcondition(bearCHoCH,    title = "Bearish CHoCH",       message = "ICT: Bearish CHoCH on {{ticker}} {{interval}}")
alertcondition(bullBOS,      title = "Bullish BOS",         message = "ICT: Bullish BOS on {{ticker}} {{interval}}")
alertcondition(bearBOS,      title = "Bearish BOS",         message = "ICT: Bearish BOS on {{ticker}} {{interval}}")
alertcondition(justSweptSSL, title = "SSL Liquidity Sweep", message = "ICT: SSL swept on {{ticker}} {{interval}}")
alertcondition(justSweptBSL, title = "BSL Liquidity Sweep", message = "ICT: BSL swept on {{ticker}} {{interval}}")
