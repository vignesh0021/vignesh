# Copy to .env to override docker-compose defaults (all optional).
# Plain `docker compose up` works with none of these set.

# ---- Plan reading (LLM) ----
# none | ollama | gemini | groq | openrouter
LLM_PROVIDER=none
# OLLAMA_MODEL=llama3.2-vision          # if LLM_PROVIDER=ollama (runs on your host)
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# ---- Photoreal render (image) ----
# pollinations (zero-key, default) | local_sd | huggingface | replicate
IMAGE_PROVIDER=pollinations
# For exact-match photoreal via the optional `sd` service (docker compose --profile gpu up):
# IMAGE_PROVIDER=local_sd
# SD_WEBUI_URL=http://sd:7860
# HF_API_KEY=
# REPLICATE_API_TOKEN=
