# ---- choose ONE free vision-LLM provider ----
# ollama (fully local & free, recommended) | gemini | groq | openrouter | none
LLM_PROVIDER=ollama

# --- Ollama (local) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision        # or: llava, qwen2.5-vl, minicpm-v

# --- Google Gemini (AI Studio free tier) ---
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# --- Groq (free tier) ---
# LLM_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.2-90b-vision-preview

# --- OpenRouter (free models) ---
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=qwen/qwen2.5-vl-72b-instruct:free

PORT=8000
