# ---- choose ONE free vision-LLM provider ----
# ollama (fully local & free, recommended) | gemini | groq | openrouter | none
LLM_PROVIDER=ollama

# --- Ollama (local) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision        # or: llava, qwen2.5-vl, minicpm-v

# --- Google Gemini (AI Studio free tier) ---
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest   # falls back automatically on 404/quota

# --- Groq (free tier) ---
# LLM_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.2-90b-vision-preview

# --- OpenRouter (free models) ---
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=qwen/qwen2.5-vl-72b-instruct:free

PORT=8000

# ============ Image detector (raster plans) — optional, docs/detector-integration.md ============
# none | http  (an object-detection microservice, e.g. a FloorPlanTo3D / Mask R-CNN server)
DETECTOR_PROVIDER=none
# DETECTOR_URL=http://localhost:9000/predict
# DETECTOR_BUILDING_WIDTH_FT=30      # used to scale px->ft when the service gives no scale

# ============ Route B: AI photoreal render ============
# pollinations (zero-key, always works) | local_sd | huggingface | replicate | none
IMAGE_PROVIDER=pollinations

# --- local Stable Diffusion (Automatic1111 / Forge) with ControlNet (best, exact) ---
# Full setup: docs/local-sd-controlnet-setup.md
# IMAGE_PROVIDER=local_sd
# SD_WEBUI_URL=http://localhost:7860       # launch the WebUI with --api
# SD_MODEL=                                # optional exact checkpoint name to pin
# SD_STEPS=28
# SD_CFG=6.5
# SD_SAMPLER=DPM++ 2M Karras
# SD_CONTROL_MODULE=canny                  # preprocessor
# SD_CONTROL_MODEL=control_v11p_sd15_canny # installed ControlNet model name (match your base model)

# --- Hugging Face Inference API (free tier, prompt only) ---
# IMAGE_PROVIDER=huggingface
# HF_API_KEY=
# HF_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# --- Replicate ---
# IMAGE_PROVIDER=replicate
# REPLICATE_API_TOKEN=
# REPLICATE_MODEL_VERSION=stability-ai/sdxl:39ed52f2...

