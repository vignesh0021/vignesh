{
  "expo": {
    "name": "TradeLikeHunter",
    "slug": "tradelikehunter",
    "version": "1.10.0",
    "scheme": "tradelikehunter",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0C",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.tradelikehunter.app",
      "versionCode": 13,
      "backgroundColor": "#0A0A0C",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0C"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tradelikehunter.app"
    },
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#0A0A0C",
      "resizeMode": "contain"
    },
    "plugins": [
      "expo-document-picker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#0B0E11",
          "resizeMode": "contain"
        }
      ]
    ],
    "newArchEnabled": false
  }
}
